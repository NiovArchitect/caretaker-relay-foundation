# Copy to .env.dev.local for local Caretaker Relay development on 5434.
# Never commit real secrets.

PRODUCT_ID=caretaker-relay
PRODUCT_NAMESPACE=cr
AUDIT_PRODUCT_TAG=caretaker-relay

DATABASE_URL=postgresql://caretaker:caretaker_local_only@localhost:5434/caretaker_relay_dev?schema=public
DIRECT_URL=postgresql://caretaker:caretaker_local_only@localhost:5434/caretaker_relay_dev?schema=public

JWT_SECRET=cr-local-dev-jwt-secret-not-for-production-32b
ENCRYPTION_KEY=cr-local-dev-encryption-key-32b!!!!!!

CARE_STORE_BACKEND=prisma
PORT=3100
CORS_ORIGIN=http://localhost:5180
PUBLIC_APP_URL=http://localhost:3100
CARETAKER_APP_URL=http://localhost:5180

# Optional live model (leave empty for fixture-only)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
CARE_UNDERSTAND_MODE=fixture
