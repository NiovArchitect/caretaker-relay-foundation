# Caretaker Relay Foundation — example environment file.
#
# Separate product from Otzar. Copy to .env.local (NOT committed).
# Never reuse Otzar production DATABASE_URL, JWT_SECRET, ENCRYPTION_KEY,
# Redis, OAuth apps, or tenant IDs.

# ── Product identity (required) ─────────────────────────────────
PRODUCT_ID=caretaker-relay
PRODUCT_NAMESPACE=cr
AUDIT_PRODUCT_TAG=caretaker-relay
ENCRYPTION_NAMESPACE=caretaker-relay
REDIS_KEY_PREFIX=cr:

# ── Core ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://caretaker:caretaker_local_only@localhost:5434/caretaker_relay_dev?schema=public
DIRECT_URL=

JWT_SECRET=replace-with-a-32-byte-random-string-cr-only
ENCRYPTION_KEY=replace-with-a-32-byte-random-string-cr

CORS_ORIGIN=http://localhost:5180
PUBLIC_APP_URL=http://localhost:3100
CARETAKER_APP_URL=http://localhost:5180
PORT=3100

LOG_LEVEL=info
AUDIT_LOG_LEVEL=info

# ── Python intelligence runtime ─────────────────────────────────
PYTHON_INTELLIGENCE_RUNTIME_URL=
PYTHON_RUNTIME_ENABLED=false
PYTHON_RUNTIME_TIMEOUT_MS=1500
PYTHON_FIXTURE_MODE=true

# ── BEAM coordination runtime ───────────────────────────────────
BEAM_RUNTIME_URL=
BEAM_RUNTIME_ENABLED=false

# ── Voice ───────────────────────────────────────────────────────
VOICE_PROVIDER=text_only
VOICE_OUTPUT_ENABLED=false
LIVE_MIC_CAPTURE_ENABLED=false
RAW_AUDIO_RETENTION_ENABLED=false

# ── Connectors (default off; do not claim integrations that do not exist)
CONNECTOR_WRITE_ENABLED=false

# ── Billing ─────────────────────────────────────────────────────
BILLING_PROVIDER=mock
PAYMENT_RAILS_ENABLED=false

# ── Observability (separate from Otzar) ─────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
METRICS_ENABLED=false
OTEL_SERVICE_NAME=caretaker-relay-api

# ── Security posture ────────────────────────────────────────────
DATA_RETENTION_MODE=standard
AUDIT_RETENTION_DAYS=365
CHAIN_OF_THOUGHT_STORAGE_ENABLED=false

# ── Optional LLM (server-side only) ─────────────────────────────
# LLM_PROVIDER=mock
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Bootstrap (local only) ──────────────────────────────────────
ALLOW_FOUNDER_BOOTSTRAP=false
FOUNDER_BOOTSTRAP_EMAIL=caregiver-demo@caretaker-relay.local
FOUNDER_BOOTSTRAP_PASSWORD=
FOUNDER_BOOTSTRAP_ORG_NAME=Caretaker Relay Demo Household
FOUNDER_BOOTSTRAP_ORG_DOMAIN=caretaker-relay.local

ALLOW_DEMO_MODE=false
